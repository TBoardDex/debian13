+static gboolean
+clear_wayland_window_background_cb (GtkWidget *widget,
+				    cairo_t   *cr,
+				    gpointer   user_data)
+{
+	(void) widget;
+	(void) user_data;
+
+	cairo_save (cr);
+	cairo_set_operator (cr, CAIRO_OPERATOR_SOURCE);
+	cairo_set_source_rgba (cr, 0.0, 0.0, 0.0, 0.0);
+	cairo_paint (cr);
+	cairo_restore (cr);
+
+	return GDK_EVENT_PROPAGATE;
+}
+
+static gboolean
+draw_wayland_video_background_cb (GtkWidget *widget,
+				  cairo_t   *cr,
+				  gpointer   user_data)
+{
+	TotemObject *totem = user_data;
+
+	(void) widget;
+	if (totem == NULL || totem->wayland_video_ready)
+		return GDK_EVENT_PROPAGATE;
+
+	cairo_save (cr);
+	cairo_set_operator (cr, CAIRO_OPERATOR_SOURCE);
+	cairo_set_source_rgb (cr, 0.0, 0.0, 0.0);
+	cairo_paint (cr);
+	cairo_restore (cr);
+
+	return GDK_EVENT_PROPAGATE;
+}
+
+static gboolean
+wayland_video_ready_tick_cb (GtkWidget *widget,
+				     GdkFrameClock *clock,
+				     gpointer user_data)
+{
+	TotemObject *totem = user_data;
+
+	(void) clock;
+	if (totem->wayland_video_tick_id != 0)
+		totem->wayland_video_tick_id = 0;
+	totem->wayland_video_ready = TRUE;
+	gtk_widget_queue_draw (widget);
+	return G_SOURCE_REMOVE;
+}
+
+static void
+wayland_video_transition_start_cb (BaconVideoWidget *bvw,
+					   TotemObject *totem)
+{
+	(void) bvw;
+	if (totem->wayland_video_tick_id != 0) {
+		gtk_widget_remove_tick_callback (totem->win,
+						 totem->wayland_video_tick_id);
+		totem->wayland_video_tick_id = 0;
+	}
+	totem->wayland_video_ready = FALSE;
+	gtk_widget_queue_draw (totem->win);
+}
+
+static void
+wayland_video_frame_ready_cb (BaconVideoWidget *bvw,
+				      TotemObject *totem)
+{
+	(void) bvw;
+	if (totem->wayland_video_tick_id == 0 && !totem->wayland_video_ready)
+		totem->wayland_video_tick_id = gtk_widget_add_tick_callback
+			(totem->win, wayland_video_ready_tick_cb, totem, NULL);
+}
+
+static gboolean
+setup_wayland_video_window (TotemObject *totem)
+{
+	GdkDisplay *display;
+	GdkVisual *visual;
+	GstElementFactory *factory;
+
+	display = gtk_widget_get_display (totem->win);
+	if (!GDK_IS_WAYLAND_DISPLAY (display) ||
+	    g_strcmp0 (g_getenv ("TOTEM_USE_GST_GTKSINK"), "1") == 0)
+		return FALSE;
+
+	factory = gst_element_factory_find ("gtkwaylandsink");
+	if (factory == NULL)
+		return FALSE;
+	gst_object_unref (factory);
+
+	visual = gdk_screen_get_rgba_visual (gtk_widget_get_screen (totem->win));
+	if (visual == NULL)
+		return FALSE;
+
+	gtk_widget_set_visual (totem->win, visual);
+	gtk_widget_set_app_paintable (totem->win, TRUE);
+	g_signal_connect (totem->win, "draw",
+			  G_CALLBACK (clear_wayland_window_background_cb), totem);
+	g_signal_connect (totem->bvw, "draw",
+			  G_CALLBACK (draw_wayland_video_background_cb), totem);
+	return TRUE;
+}
+
+static void wayland_transition_cancel (TotemObject *totem);
+
+static gboolean
+wayland_transition_cover_draw_cb (GtkWidget *widget, cairo_t *cr, gpointer data)
+{
+	TotemObject *totem = data;
+	(void) widget;
+	totem->wayland_transition_cover_drawn = TRUE;
+	cairo_set_source_rgb (cr, 0.0, 0.0, 0.0);
+	cairo_paint (cr);
+	return GDK_EVENT_STOP;
+}
+
+static void
+wayland_transition_after_paint_cb (GdkFrameClock *clock, TotemObject *totem)
+{
+	if (clock != totem->wayland_transition_clock)
+		return;
+	if (totem->wayland_transition_state == WAYLAND_TRANSITION_WAIT_TARGET) {
+		totem->wayland_transition_state = WAYLAND_TRANSITION_IDLE;
+		g_signal_handler_disconnect (clock, totem->wayland_transition_handler);
+		totem->wayland_transition_handler = 0;
+		totem->wayland_transition_clock = NULL;
+		gtk_widget_hide (totem->wayland_transition_cover);
+		return;
+	}
+	if (totem->wayland_transition_state != WAYLAND_TRANSITION_WAIT_COVER ||
+	    !totem->wayland_transition_cover_drawn)
+		return;
+	totem->wayland_transition_state = WAYLAND_TRANSITION_WAIT_TARGET;
+	totem_playlist_clear (totem->playlist);
+	totem_object_set_main_page (totem, "grilo");
+	gtk_window_unfullscreen (GTK_WINDOW (totem->win));
+	bacon_video_widget_set_show_cursor (totem->bvw, TRUE);
+	gtk_widget_queue_draw (totem->stack);
+}
+
+static void
+wayland_transition_begin (TotemObject *totem)
+{
+	GdkFrameClock *clock;
+	if (totem->wayland_transition_cover == NULL ||
+	    totem->wayland_transition_state != WAYLAND_TRANSITION_IDLE)
+		return;
+	gtk_widget_show (totem->wayland_transition_cover);
+	totem->wayland_transition_cover_drawn = FALSE;
+	gtk_widget_queue_draw (totem->wayland_transition_cover);
+	clock = gtk_widget_get_frame_clock (totem->win);
+	if (clock == NULL) {
+		gtk_widget_hide (totem->wayland_transition_cover);
+		totem_playlist_clear (totem->playlist);
+		totem_object_set_main_page (totem, "grilo");
+		gtk_window_unfullscreen (GTK_WINDOW (totem->win));
+		bacon_video_widget_set_show_cursor (totem->bvw, TRUE);
+		return;
+	}
+	totem->wayland_transition_clock = clock;
+	totem->wayland_transition_state = WAYLAND_TRANSITION_WAIT_COVER;
+	totem->wayland_transition_handler = g_signal_connect
+		(clock, "after-paint", G_CALLBACK (wayland_transition_after_paint_cb), totem);
+}
+
+static void
+wayland_transition_cancel (TotemObject *totem)
+{
+	if (totem->wayland_transition_clock != NULL &&
+	    totem->wayland_transition_handler != 0)
+		g_signal_handler_disconnect (totem->wayland_transition_clock,
+					     totem->wayland_transition_handler);
+	totem->wayland_transition_clock = NULL;
+	totem->wayland_transition_handler = 0;
+	totem->wayland_transition_state = WAYLAND_TRANSITION_IDLE;
+	totem->wayland_transition_cover_drawn = FALSE;
+	if (totem->wayland_transition_cover != NULL)
+		gtk_widget_hide (totem->wayland_transition_cover);
+}
+
